// ═══════════════════════════════════════════════════════════════════════
// NVDA AutoTrader — TradingView port of nvda_autotrader.py v4.98
// ═══════════════════════════════════════════════════════════════════════
// HOW TO USE
//   1. Open NVDA on the 5-minute chart, regular trading hours (RTH).
//   2. Pine Editor → paste this → Save → Add to chart.
//      Strategy Tester = TradingView's simulated (paper) results on live bars.
//   3. To send orders to Alpaca paper through the bot: set "Webhook
//      passphrase" below (same as the dashboard's TradingView tab), then
//      Create Alert → Condition: this strategy → "Order fills only" →
//      Webhook URL: https://<your-tunnel>/tv_webhook →
//      Message: {{strategy.order.alert_message}}
//
// WHAT'S PORTED (same rules and defaults as the Python bot)
//   SPIKE (momentum)  — ≥2.5×ATR move over 3 bars, ≥1.5×ATR from VWAP,
//                       rejection candle; stop 1.5×ATR beyond the spike,
//                       target 1.5×ATR back toward VWAP
//   SPIKE (extreme)   — price within 0.5×ATR of the 5-day high/low, bounced
//                       ≥0.1×ATR, reversal candle, on the far side of VWAP
//   VWAP bounce       — prior bar tagged the VWAP ±1×ATR band, strong candle
//                       back through VWAP, scored /9 like the bot
//   FVG retrace       — best-scoring fair value gap of the day, entered when
//                       price retraces into the lower/upper half of the gap
//   SWING-6M / 3M     — within 3% of the 6/3-month daily high/low with the
//                       intraday trend already turned; 2.5R target. 6M can
//                       hold overnight (max 10 days) like the bot.
//   Selection: when several fire on one bar, the best reward:risk wins —
//   same as the bot's check_for_entry().
//
// KNOWN DIFFERENCES FROM THE PYTHON BOT
//   - RANGE (intraday range-bounce) is not ported.
//   - Multi-timeframe bias / daily momentum score adjustments are not ported;
//     score thresholds use only QQQ alignment (2 aligned/neutral, 4 opposite).
//   - Trailing stop, FVG 45-min time stop and near-target lock are not ported.
//   - An FVG is used once (the bot can re-trade its best FVG of the day).
//   - TradingView volume is consolidated; the bot's Alpaca IEX volume is a
//     small slice of the market, so VWAP and volume scores differ a little.
// ═══════════════════════════════════════════════════════════════════════

//@version=6
strategy("NVDA AutoTrader v4.98", shorttitle = "NVDA AT", overlay = true,
     initial_capital = 100000, default_qty_type = strategy.fixed, default_qty_value = 1,
     pyramiding = 0, process_orders_on_close = true, commission_value = 0,
     max_bars_back = 1000)

TZ = "America/New_York"

// ── Inputs ──────────────────────────────────────────────────────────────
gS = "Strategies"
useSpike    = input.bool(true,  "SPIKE momentum",         group = gS)
useExtreme  = input.bool(true,  "SPIKE 5-day extreme",    group = gS)
useVwap     = input.bool(true,  "VWAP bounce",            group = gS)
useFvg      = input.bool(true,  "FVG retrace",            group = gS)
useSwing6   = input.bool(true,  "SWING-6M",               group = gS)
useSwing3   = input.bool(false, "SWING-3M (off in bot)",  group = gS)

gK = "Kill zones (ET)"
kz1 = input.session("0930-1100", "Kill zone 1", group = gK)
kz2 = input.session("1200-1300", "Kill zone 2", group = gK)
kz3 = input.session("1400-1555", "Kill zone 3", group = gK)
showKz = input.bool(true, "Shade kill zones", group = gK)

gR = "Risk"
riskPct     = input.float(0.2, "Risk per trade (% equity)", minval = 0.01, step = 0.05, group = gR)
maxPosPct   = input.float(5.0, "Max position (% equity)",   minval = 0.5,  step = 0.5,  group = gR)
rr          = input.float(1.5, "Reward:risk (VWAP / FVG)",  minval = 0.5,  step = 0.1,  group = gR)
stopAtrMult = input.float(2.0, "FVG stop (× ATR)",          minval = 0.5,  step = 0.1,  group = gR)
atrLen      = input.int(14,    "ATR length (bars)",         minval = 2,                 group = gR)
flatEod     = input.bool(true, "Flatten at 15:55 ET (except SWING-6M)", group = gR)

gP = "Strategy parameters"
trendLen      = input.int(25,     "Trend lookback (bars)",           group = gP)
trendThr      = input.float(0.15, "Trend threshold (%)",             group = gP)
qqqSym        = input.symbol("NASDAQ:QQQ", "QQQ symbol",             group = gP)
spikeAtr      = input.float(2.5,  "Spike size (× ATR)",              group = gP)
spikeVwap     = input.float(1.5,  "Spike distance from VWAP (× ATR)", group = gP)
spikeBars     = input.int(3,      "Spike lookback (bars)",           group = gP)
spikeStop     = input.float(1.5,  "Spike/extreme stop (× ATR)",      group = gP)
spikeTarget   = input.float(1.5,  "Spike/extreme target (× ATR)",    group = gP)
extremeDays   = input.int(5,      "Extreme lookback (days)",         group = gP)
extremeProx   = input.float(0.5,  "Extreme proximity (× ATR)",       group = gP)
vwapBand      = input.float(1.0,  "VWAP band (× ATR)",               group = gP)
vwapBody      = input.float(0.5,  "VWAP min body ratio",             group = gP)
vwapMinBars   = input.int(20,     "VWAP min bars today",             group = gP)
fvgMin        = input.float(0.20, "FVG min size ($)",                group = gP)
fvgMax        = input.float(2.00, "FVG max size ($)",                group = gP)
fvgBody       = input.float(0.40, "FVG middle-candle body ratio",    group = gP)
fvgMaxDist    = input.float(2.0,  "FVG max entry distance (%)",      group = gP)
swingPct      = input.float(3.0,  "Swing proximity (%)",             group = gP)
swingStop     = input.float(1.0,  "Swing stop (× ATR beyond extreme)", group = gP)
swingRR       = input.float(2.5,  "Swing reward:risk",               group = gP)
swingHoldDays = input.int(10,     "SWING-6M max hold (days)",        group = gP)

gW = "Webhook (TradingView → bot → Alpaca)"
passphrase = input.string("", "Webhook passphrase", group = gW,
     tooltip = "Must match the passphrase in the dashboard's TradingView tab.")
sendQty = input.bool(false, "Send share qty in alert", group = gW,
     tooltip = "Off: the bot sizes the order from your Alpaca equity (recommended). On: uses this script's qty.")

// ── Helpers ─────────────────────────────────────────────────────────────
inSess(s) => not na(time(timeframe.period, s, TZ))
inKz1 = inSess(kz1)
inKz  = inKz1 or inSess(kz2) or inSess(kz3)
mins  = hour(time, TZ) * 60 + minute(time, TZ)
newDay = na(time[1]) or dayofmonth(time, TZ) != dayofmonth(time[1], TZ)

f2(x) => str.tostring(x, "#.##")

entryMsg(string side, string strat, float stp, float tgt, int q) =>
    '{"passphrase":"' + passphrase + '","ticker":"' + syminfo.ticker + '","action":"' + side +
     '","strategy":"' + strat + '","stop":' + f2(stp) + ',"target":' + f2(tgt) +
     ',"qty":' + str.tostring(sendQty ? q : 0) + '}'

closeMsg(string strat) =>
    '{"passphrase":"' + passphrase + '","ticker":"' + syminfo.ticker + '","action":"close","strategy":"' + strat + '"}'

// ── Core series ─────────────────────────────────────────────────────────
atr   = ta.sma(ta.tr(true), atrLen)          // bot: simple mean of true range
vwap  = ta.vwap(hlc3)
upper = vwap + vwapBand * atr
lower = vwap - vwapBand * atr

trendChg = (close - close[trendLen - 1]) / close[trendLen - 1] * 100
trend    = trendChg > trendThr ? 1 : trendChg < -trendThr ? -1 : 0

qqq    = request.security(qqqSym, timeframe.period, close)
qqqChg = (qqq - qqq[11]) / qqq[11] * 100
qqqDir = qqqChg > 0.15 ? 1 : qqqChg < -0.15 ? -1 : 0

// session bar count + average volume (bot averages today's bars)
var int   sBars = 0
var float sVol  = 0.0
if newDay
    sBars := 0
    sVol  := 0.0
sBars += 1
sVol  += volume
sAvgVol = sVol / sBars

scoreThreshold(int dir) => qqqDir == dir or qqqDir == 0 ? 2 : 4

// ── Candidate bookkeeping ───────────────────────────────────────────────
var int    cDir  = 0
var float  cStop = na
var float  cTgt  = na
var float  cRR   = 0.0
var string cName = ""
cDir  := 0
cStop := na
cTgt  := na
cRR   := 0.0
cName := ""

consider(int dir, float stp, float tgt, string name) =>
    float risk = math.abs(close - stp)
    float r    = risk > 0 ? math.abs(tgt - close) / risk : 0.0
    bool better = dir != 0 and risk > 0 and r > cRR
    [better, r]

// ── 1. SPIKE momentum ───────────────────────────────────────────────────
mvHigh = ta.highest(high, spikeBars)
mvLow  = ta.lowest(low, spikeBars)
mvOpen = open[spikeBars - 1]
vDist  = close - vwap
if useSpike and atr > 0
    if mvHigh - mvOpen >= spikeAtr * atr and vDist >= spikeVwap * atr and close < open
        s = mvHigh + spikeStop * atr
        t = close - spikeTarget * atr
        [b, r] = consider(-1, s, t, "SPIKE")
        if b
            cDir := -1, cStop := s, cTgt := t, cRR := r, cName := "SPIKE"
    else if mvOpen - mvLow >= spikeAtr * atr and -vDist >= spikeVwap * atr and close > open
        s = mvLow - spikeStop * atr
        t = close + spikeTarget * atr
        [b, r] = consider(1, s, t, "SPIKE")
        if b
            cDir := 1, cStop := s, cTgt := t, cRR := r, cName := "SPIKE"

// ── 2. SPIKE 5-day extreme ──────────────────────────────────────────────
exBars = math.min(extremeDays * 78, 999)
rHigh  = ta.highest(close, exBars)
rLow   = ta.lowest(close, exBars)
if useExtreme and atr > 0 and bar_index > exBars
    prox = extremeProx * atr
    minBounce = 0.10 * atr
    if close <= rLow + prox and close - rLow >= minBounce and close > open and vDist < 0
        s = rLow - spikeStop * atr
        t = close + spikeTarget * atr
        [b, r] = consider(1, s, t, "SPIKE-EXT")
        if b
            cDir := 1, cStop := s, cTgt := t, cRR := r, cName := "SPIKE-EXT"
    else if close >= rHigh - prox and rHigh - close >= minBounce and close < open and vDist > 0
        s = rHigh + spikeStop * atr
        t = close - spikeTarget * atr
        [b, r] = consider(-1, s, t, "SPIKE-EXT")
        if b
            cDir := -1, cStop := s, cTgt := t, cRR := r, cName := "SPIKE-EXT"

// ── 3. VWAP bounce ──────────────────────────────────────────────────────
rng   = high - low
bodyR = rng > 0 ? math.abs(close - open) / rng : 0.0
if useVwap and atr > 0 and sBars >= vwapMinBars and bodyR >= vwapBody
    int vDir = 0
    if low[1] <= lower and close > open and close > vwap and trend != -1 and qqqDir != -1
        vDir := 1
    else if high[1] >= upper and close < open and close < vwap and trend != 1 and qqqDir != 1
        vDir := -1
    if vDir != 0
        int score = (bodyR >= 0.65 ? 2 : 1) + (qqqDir == vDir ? 2 : 0) + (trend == vDir ? 1 : 0) +
             (volume > sAvgVol * 1.3 ? 1 : 0) + (inKz1 ? 1 : 0)
        if score >= scoreThreshold(vDir)
            s = vDir == 1 ? lower - 1.5 * atr : upper + 1.5 * atr
            risk = math.abs(close - s)
            t = close + vDir * risk * rr
            [b, r] = consider(vDir, s, t, "VWAP")
            if b
                cDir := vDir, cStop := s, cTgt := t, cRR := r, cName := "VWAP"

// ── 4. FVG retrace ──────────────────────────────────────────────────────
var int   fDir   = 0
var float fTop   = na
var float fBot   = na
var float fEz    = na
var int   fScore = -1
if newDay
    fDir := 0, fTop := na, fBot := na, fEz := na, fScore := -1

midRange = high[1] - low[1]
midBody  = midRange > 0 ? math.abs(close[1] - open[1]) / midRange : 0.0
if midBody >= fvgBody and not newDay and not newDay[1]
    int   nDir = 0
    float nTop = na
    float nBot = na
    if high < low[2] and trend != 1                         // bearish gap
        nDir := -1, nTop := low[2], nBot := high
    else if low > high[2] and trend != -1                   // bullish gap
        nDir := 1, nTop := low, nBot := high[2]
    if nDir != 0
        gap = nTop - nBot
        if gap >= fvgMin and gap <= fvgMax
            int sc = (inKz1 ? 3 : 0) + (gap <= 0.50 ? 2 : 0) + (qqqDir == nDir ? 2 : 0) +
                 (midBody >= 0.70 ? 1 : 0) + (volume[1] > sAvgVol * 1.3 ? 1 : 0)
            if sc > fScore
                fDir := nDir, fTop := nTop, fBot := nBot, fScore := sc
                fEz  := nBot + gap * 0.5

if useFvg and fDir != 0 and atr > 0 and fScore >= scoreThreshold(fDir)
    near = math.abs(close - fEz) / close * 100 <= fvgMaxDist
    inZone = fDir == 1 ? close >= fBot and close <= fEz : close >= fEz and close <= fTop
    if near and inZone
        s = close - fDir * stopAtrMult * atr
        t = close + fDir * stopAtrMult * atr * rr
        [b, r] = consider(fDir, s, t, "FVG")
        if b
            cDir := fDir, cStop := s, cTgt := t, cRR := r, cName := "FVG"

// ── 5. SWING-6M / SWING-3M ──────────────────────────────────────────────
// Completed daily bars only (no lookahead repaint), like the bot's once-a-day fetch.
[hi6, lo6, hi3, lo3] = request.security(syminfo.tickerid, "D",
     [ta.highest(high, 126)[1], ta.lowest(low, 126)[1], ta.highest(high, 63)[1], ta.lowest(low, 63)[1]],
     lookahead = barmerge.lookahead_on)

swing(bool on, float hi, float lo) =>
    int   d = 0
    float s = na
    float t = na
    if on and atr > 0 and not na(hi) and not na(lo)
        prox = swingPct / 100 * close
        if close >= hi - prox and trend == -1
            s := hi + swingStop * atr
            d := s > close ? -1 : 0
        else if close <= lo + prox and trend == 1
            s := lo - swingStop * atr
            d := s < close ? 1 : 0
        if d != 0
            t := close + d * math.abs(close - s) * swingRR
    [d, s, t]

[d6, s6, t6] = swing(useSwing6, hi6, lo6)
if d6 != 0
    [b, r] = consider(d6, s6, t6, "SWING-6M")
    if b
        cDir := d6, cStop := s6, cTgt := t6, cRR := r, cName := "SWING-6M"
[d3, s3, t3] = swing(useSwing3, hi3, lo3)
if d3 != 0
    [b, r] = consider(d3, s3, t3, "SWING-3M")
    if b
        cDir := d3, cStop := s3, cTgt := t3, cRR := r, cName := "SWING-3M"

// ── Entry ───────────────────────────────────────────────────────────────
var float  tStop  = na
var float  tTgt   = na
var string tName  = ""
var int    daysHeld = 0

flat = strategy.position_size == 0
lastEntryMin = flatEod and not (cName == "SWING-6M") ? 15 * 60 + 50 : 15 * 60 + 55
if flat and inKz and cDir != 0 and mins < lastEntryMin
    risk  = math.abs(close - cStop)
    qRisk = math.floor(strategy.equity * riskPct / 100 / risk)
    qMax  = math.floor(strategy.equity * maxPosPct / 100 / close)
    q     = math.max(1, math.min(qRisk, qMax))
    tStop := cStop, tTgt := cTgt, tName := cName, daysHeld := 0
    strategy.entry(cName, cDir == 1 ? strategy.long : strategy.short, qty = q, comment = cName,
         alert_message = entryMsg(cDir == 1 ? "buy" : "sell", cName, cStop, cTgt, q))
    // protect the entry bar itself — the exit block below only runs once a position exists
    strategy.exit("Exit", from_entry = cName, stop = cStop, limit = cTgt,
         comment_loss = "Stop", comment_profit = "Target", alert_message = closeMsg(cName))
    if cName == "FVG"
        fDir := 0                                  // use each gap once

if not flat and newDay
    daysHeld += 1

// ── Exits ───────────────────────────────────────────────────────────────
if strategy.position_size != 0
    strategy.exit("Exit", from_entry = tName, stop = tStop, limit = tTgt,
         comment_loss = "Stop", comment_profit = "Target", alert_message = closeMsg(tName))
    holdOver = tName == "SWING-6M" and daysHeld < swingHoldDays
    if flatEod and mins >= 15 * 60 + 50 and not holdOver
        strategy.close_all(comment = "EOD", alert_message = closeMsg(tName))
    if tName == "SWING-6M" and daysHeld >= swingHoldDays and mins >= 15 * 60 + 50
        strategy.close_all(comment = "Max hold", alert_message = closeMsg(tName))

// ── Visuals ─────────────────────────────────────────────────────────────
plot(vwap,  "VWAP",       color = color.new(#5b8cff, 0),  linewidth = 2)
plot(upper, "VWAP upper", color = color.new(#5b8cff, 65))
plot(lower, "VWAP lower", color = color.new(#5b8cff, 65))
inPos = strategy.position_size != 0
plot(inPos ? tStop : na, "Stop",   color = color.new(#f87171, 0), style = plot.style_linebr, linewidth = 2)
plot(inPos ? tTgt  : na, "Target", color = color.new(#34d399, 0), style = plot.style_linebr, linewidth = 2)
plot(fDir != 0 ? fTop : na, "FVG top",    color = color.new(#fbbf24, 40), style = plot.style_linebr)
plot(fDir != 0 ? fBot : na, "FVG bottom", color = color.new(#fbbf24, 40), style = plot.style_linebr)
bgcolor(showKz and inKz ? color.new(#5b8cff, 93) : na, title = "Kill zone")
